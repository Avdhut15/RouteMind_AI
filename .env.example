# RouteMind_AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to Git.

# ── OpenRouter ─────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Ollama (local) ─────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ── Groq (Phase 1+ integration, optional) ──────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Google Gemini (Phase 1+ integration, optional) ─────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Mistral (Phase 1+ integration, optional) ───────────────────────────────────
MISTRAL_API_KEY=your_mistral_api_key_here

# ── Application ────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── Database (Phase 4+) ────────────────────────────────────────────────────────
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/routemind
